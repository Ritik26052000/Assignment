# Copy to .env and adjust as needed.
# Used by docker compose (and documented for local runs).

# PostgreSQL
DB_URL=jdbc:postgresql://postgres:5432/taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow

# JWT — must be at least 32 characters (256 bits). Change in real deployments.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=60

# CORS (comma-separated). Docker frontend is served on :80; Vite on :5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Demo seed + Swagger (true in docker-compose / local review)
SEED_DEMO_DATA=true
SWAGGER_ENABLED=true
SPRING_PROFILES_ACTIVE=dev

# Frontend (local Vite). In Docker the image bakes VITE_API_URL=/api/v1.
VITE_API_URL=http://localhost:8080/api/v1
